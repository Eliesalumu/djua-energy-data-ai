{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "DJUA AI Solar Advisor Recommendation Request",
  "type": "object",
  "required": ["appliances"],
  "properties": {
    "customer_id": {"type": ["string", "null"]},
    "city": {"type": ["string", "null"]},
    "region": {"type": ["string", "null"]},
    "housing_type": {"type": ["string", "null"]},
    "people_count": {"type": ["integer", "null"], "minimum": 1},
    "autonomy_hours": {"type": ["number", "null"], "minimum": 1},
    "budget": {"type": ["number", "null"], "minimum": 0},
    "preference": {"type": "string", "enum": ["economy", "balanced", "performance", "autonomy"]},
    "source": {"type": "string"},
    "contact": {"type": "object"},
    "appliances": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["name"],
        "properties": {
          "name": {"type": "string"},
          "appliance_id": {"type": ["string", "null"]},
          "quantity": {"type": "integer", "minimum": 1},
          "hours_per_day": {"type": ["number", "null"], "minimum": 0},
          "power_w": {"type": ["number", "null"], "minimum": 0},
          "usage_period": {"type": "string", "enum": ["day", "night", "mixed", "continuous"]},
          "essential": {"type": "boolean"},
          "simultaneous": {"type": "boolean"}
        }
      }
    }
  }
}
