{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "customer_decision_result.v1",
  "description": "Sortie explicable du Customer Decision Engine.",
  "type": "object",
  "additionalProperties": true,
  "required": ["schema_version", "request_id", "identity_status", "scores", "decision", "reasons", "confidence", "data_quality", "model"],
  "properties": {
    "schema_version": {"type": "string", "const": "customer-decision-result.v1"},
    "decision_id": {"type": ["string", "null"]},
    "request_id": {"type": ["string", "null"]},
    "as_of": {"type": ["string", "null"]},
    "identity": {"type": "object", "additionalProperties": true},
    "identity_status": {
      "type": "string",
      "enum": ["resolved", "partial", "unresolved", "kit_without_customer", "invalid"]
    },
    "scores": {
      "type": "object",
      "required": ["client_value", "payment_risk", "operational_risk", "intervention_priority"],
      "properties": {
        "client_value": {"type": ["integer", "null"], "minimum": 0, "maximum": 100},
        "payment_risk": {"type": ["integer", "null"], "minimum": 0, "maximum": 100},
        "operational_risk": {"type": ["integer", "null"], "minimum": 0, "maximum": 100},
        "intervention_priority": {"type": ["integer", "null"], "minimum": 0, "maximum": 100}
      }
    },
    "decision": {
      "type": "object",
      "required": ["priority", "recommended_action", "human_review_required"],
      "properties": {
        "priority": {"type": "string", "enum": ["critical", "high", "medium", "low"]},
        "recommended_action": {
          "type": "string",
          "enum": [
            "urgent_technical_intervention",
            "technical_intervention",
            "commercial_follow_up",
            "payment_monitoring",
            "monitor",
            "resolve_identity",
            "fix_data_quality",
            "fix_payload"
          ]
        },
        "human_review_required": {"type": "boolean"}
      }
    },
    "reasons": {"type": "array", "items": {"type": "string"}},
    "reason_codes": {"type": "array", "items": {"type": "string"}},
    "confidence": {"type": "number", "minimum": 0, "maximum": 1},
    "data_quality": {
      "type": "object",
      "required": ["status", "missing_features", "warnings"],
      "properties": {
        "status": {"type": "string", "enum": ["complete", "partial", "blocked"]},
        "telemetry_age_seconds": {"type": ["integer", "null"], "minimum": 0},
        "missing_features": {"type": "array", "items": {"type": "string"}},
        "warnings": {"type": "array", "items": {"type": "string"}}
      }
    },
    "model": {"type": "object", "additionalProperties": true},
    "traceability": {"type": "object", "additionalProperties": true}
  }
}
