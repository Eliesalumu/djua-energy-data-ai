{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "telemetry.v1",
  "description": "Contrat de telemetrie MVP pour les messages issus du boitier solaire.",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "message_id",
    "schema_version",
    "message_type",
    "device_id",
    "kit_id",
    "serial_number",
    "event_time",
    "sequence_number",
    "battery_voltage_v",
    "battery_current_a",
    "battery_power_w",
    "battery_temperature_c",
    "state_of_charge_pct",
    "state_of_health_pct"
  ],
  "properties": {
    "message_id": {"type": "string"},
    "schema_version": {"type": "string"},
    "message_type": {"type": "string", "const": "telemetry"},
    "device_id": {"type": "string"},
    "kit_id": {"type": "string"},
    "serial_number": {"type": "string"},
    "event_time": {"type": "string"},
    "sequence_number": {"type": "integer", "minimum": 1},
    "battery_voltage_v": {"type": "number", "exclusiveMinimum": 0},
    "battery_current_a": {"type": "number"},
    "battery_power_w": {"type": "number"},
    "battery_temperature_c": {"type": "number"},
    "state_of_charge_pct": {"type": "number", "minimum": 0, "maximum": 100},
    "state_of_health_pct": {"type": "number", "minimum": 0, "maximum": 100},
    "region": {"type": "string"},
    "season": {"type": "string", "enum": ["dry", "rainy", "harmattan", "transition"]},
    "day_period": {"type": "string", "enum": ["day", "night"]},
    "ambient_temperature_c": {"type": "number"},
    "humidity_pct": {"type": "number", "minimum": 0, "maximum": 100},
    "solar_irradiance_w_m2": {"type": "number", "minimum": 0},
    "network_quality": {"type": "string", "enum": ["good", "medium", "weak"]},
    "installation_type": {"type": "string"},
    "battery_age_months": {"type": "integer", "minimum": 0},
    "usage_profile": {"type": "string", "enum": ["low", "normal", "intensive"]},
    "security_risk_zone": {"type": "string", "enum": ["low", "medium", "high"]},
    "charge_duration_seconds": {"type": "number", "minimum": 0},
    "discharge_duration_seconds": {"type": "number", "minimum": 0},
    "solar_voltage_v": {"type": "number"},
    "solar_current_a": {"type": "number"},
    "solar_power_w": {"type": "number"},
    "energy_generated_wh": {"type": "number"},
    "panel_temperature_c": {"type": "number"},
    "solar_error_code": {"type": "string"},
    "load_voltage_v": {"type": "number"},
    "load_current_a": {"type": "number"},
    "load_power_w": {"type": "number"},
    "energy_consumed_wh": {"type": "number"},
    "overload_detected": {"type": "boolean"},
    "short_circuit_detected": {"type": "boolean"},
    "latitude": {"type": "number"},
    "longitude": {"type": "number"},
    "gps_accuracy_m": {"type": "number"},
    "distance_from_installation_m": {"type": "number"},
    "geofence_status": {"type": "string", "enum": ["inside", "outside", "unknown"]},
    "speed_mps": {"type": "number"},
    "movement_detected": {"type": "boolean"},
    "movement_duration_seconds": {"type": "number", "minimum": 0},
    "movement_event_count": {"type": "number", "minimum": 0},
    "tamper_detected": {"type": "boolean"},
    "enclosure_opened": {"type": "boolean"},
    "impact_detected": {"type": "boolean"},
    "identity_mismatch_detected": {"type": "boolean"},
    "connectivity_type": {"type": "string"},
    "connection_status": {"type": "string"},
    "connectivity_gap_seconds": {"type": "integer", "minimum": 0},
    "network_operator": {"type": "string"},
    "device_temperature_c": {"type": "number"},
    "reset_count": {"type": "integer", "minimum": 0},
    "missing_measurement_count": {"type": "integer", "minimum": 0},
    "sensor_failure_detected": {"type": "boolean"},
    "abnormal_consumption_detected": {"type": "boolean"},
    "battery_error_code": {"type": "string"},
    "device_error_code": {"type": "string"}
  }
}
