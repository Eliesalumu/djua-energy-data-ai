{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "payment.v1",
  "description": "Contrat agregat paiement pour le Customer Decision Engine. Le backend reste proprietaire des paiements bruts et fournit a l'IA un snapshot rattache a customer_id/contract_id.",
  "type": "object",
  "additionalProperties": true,
  "required": ["customer_id", "contract_id", "as_of", "currency"],
  "properties": {
    "customer_id": {"type": "string"},
    "contract_id": {"type": "string"},
    "as_of": {"type": "string"},
    "currency": {"type": "string"},
    "payments_last_6_months": {"type": "integer", "minimum": 0},
    "late_payments_last_6_months": {"type": "integer", "minimum": 0},
    "missed_payments_last_6_months": {"type": "integer", "minimum": 0},
    "failed_payments_last_6_months": {"type": "integer", "minimum": 0},
    "payment_success_rate": {"type": "number", "minimum": 0, "maximum": 1},
    "average_days_late": {"type": "number", "minimum": 0},
    "outstanding_balance": {"type": "number", "minimum": 0},
    "days_since_last_payment": {"type": ["number", "null"], "minimum": 0},
    "last_payment_status": {
      "type": "string",
      "enum": ["paid", "completed", "late", "missed", "failed", "rejected", "pending", "unknown"]
    },
    "source": {"type": "object", "additionalProperties": true}
  }
}
