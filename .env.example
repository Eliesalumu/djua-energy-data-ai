# Variables d’environnement attendues pour les prochaines étapes
# Les valeurs ci-dessous sont des placeholders et ne doivent pas être utilisées en production.
APP_ENV=local
APP_DEBUG=false
DJUA_DATABASE_URL=sqlite:///data/runtime/djua_realtime.sqlite
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_DATABASE=djua_energy
MYSQL_USER=app
MYSQL_PASSWORD=change-me
MQTT_BROKER=127.0.0.1
DJUA_EXTERNAL_API_BASE_URL=https://ton-api-djua.example.com
OPENAI_API_KEY=
DJUA_OPENAI_MODEL=gpt-4.1-mini

# WhatsApp Cloud API : secrets a definir dans Environment sur Render.
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
# Version active de Graph API selectionnee dans votre application Meta, ex. vXX.0.
WHATSAPP_API_VERSION=
WHATSAPP_APP_SECRET=
# Vide : technician/support limites aux devices associes. customer jamais global.
WHATSAPP_GLOBAL_ROLES=
